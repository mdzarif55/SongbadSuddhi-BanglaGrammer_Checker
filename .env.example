# Google Gemini API configuration
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended models: gemini-2.5-flash, gemini-1.5-flash, or gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Security & limits
MAX_ARTICLE_CHARS=25000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Editorial dictionary engine options
ENABLE_DICTIONARY_CHECK=true
DEFAULT_EDITORIAL_STYLE=bangla_academy # Options: bangla_academy, modern_newsroom
